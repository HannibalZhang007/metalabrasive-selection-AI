  /* ---- Industry change → auto-fill preset ---- */
  function fillPreset(){
    var v = $('sel-industry').value;
    if(!v || !IND[v]) return;
    var p = IND[v].preset;
    $('sel-base').value = p.base;
    $('sel-surface').value = p.surface;
    $('sel-rough').value = p.rough;
    $('sel-equip').value = p.equip;
    $('sel-power').value = p.power;
    $('sel-life').value = p.life;
