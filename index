  /* ---- Roughness + shape → particle spec ---- */
  function specByShape(m, rough){
    var sk = m.shapeKey;
    var phi = (rough==='<50' || rough==='40-80') ? 'φ0.4'
            : (rough==='50-80') ? 'φ0.6'
            : (rough==='50-100') ? 'φ0.8'
            : (rough==='80-120') ? 'φ1.0' : 'φ1.2-1.4';
    if(sk === 'sshot'){ return phi; }
    if(sk === 'spherical'){
      if(rough==='<50' || rough==='40-80') return 'S170';
      if(rough==='50-80') return 'S230';
      if(rough==='50-100') return 'S280';
      return 'S330/S390';
    }
    if(sk === 'angular'){
      if(rough==='<50' || rough==='40-80') return 'G80';
      if(rough==='50-80') return 'G40';
      if(rough==='50-100') return 'G25';
      return 'G16/G18';
    }
    if(sk === 'grinding'){
      return m.grade ? (m.grade + ' ' + phi) : (phi + ' (roundness G3)');
    }
    return phi;
  }

  /* ---- Main / sub material selection ---- */
  function pickMainSub(indKey, equip, surface, rough){
    var eq = equip || '';
    var base = $('sel-base').value;
    if(base === '不锈钢' || base === '有色金属(铝/铜/锌)'){
      if(surface === '喷丸强化' || surface === '精密清理/抛光'){
        return {main:'J', sub:'-', mix:'100:0'};
      }
      return {main:'O', sub:'-', mix:'100:0'};
    }
    if(surface === '喷丸强化'){
      var heavy = (rough === '80-120' || rough === '>120');
      if(eq.indexOf('喷砂') >= 0){
        return {main: heavy ? 'D' : 'C', sub:'-', mix:'100:0'};
      }
      return {main: heavy ? 'H' : 'A', sub:'-', mix:'100:0'};
    }
    var m = MATRIX[indKey];
    if(eq.indexOf('抛丸') >= 0) return {main:m.wheel[0], sub:m.wheel[1], mix:m.wheel[2]};
    if(eq.indexOf('喷砂') >= 0) return {main:m.blast[0], sub:m.blast[1], mix:m.blast[2]};
    var ind = IND[indKey];
    return {main:ind.main, sub:ind.sub, mix:ind.mix};
  }

  /* ---- Generate recommendation ---- */
  function gen(){
    var v = $('sel-industry').value;
    if(!v || !IND[v]){ alert('Please select an industry first. / 请先选择行业类型'); return; }
    var ind = IND[v];
    var base = $('sel-base').value;
    var surface = $('sel-surface').value;
    var rough = $('sel-rough').value;
    var equip = $('sel-equip').value;
    var power = $('sel-power').value;
    var life = $('sel-life').value;
    var recover = $('sel-recover').value;
    var env = $('sel-env').value;
    var thr = parseFloat($('sel-throughput').value) || 0;

    var sel = pickMainSub(v, equip, surface, rough);
    var mainCode = sel.main;
    var subCode = (sel.sub && sel.sub!='-') ? sel.sub : null;
    var main = ABR[mainCode];
    var sub = subCode ? ABR[subCode] : null;

    $('sel-res-industry').textContent = 'Industry: ' + ind.en + ' · ' + ind.zh;

    var grid = $('sel-res-grid'); grid.innerHTML='';
    var code = mainCode + (subCode ? (' + '+subCode) : '');
    var name = main.en + (sub ? (' + '+sub.en) : '');
    var mix = (subCode===mainCode || !subCode) ? ('Single media 100% '+mainCode) : (mainCode+':'+subCode+' (fine-tune by test)');
    var hard = recHard(mainCode, subCode, surface);
    var cyc = main.cyc + (sub ? (' / '+sub.cyc) : '');
    var items = [
      ['Code / 编码', code],
      ['Abrasive / 推荐磨料', name],
      ['Spec (particle) / 规格', specByShape(main, rough) + (sub ? (' + sub '+specByShape(sub, rough)) : '')],
      ['Hardness / 硬度', hard],
      ['Mix ratio / 混合比', mix],
      ['Cycles / 循环次数', cyc]
    ];
    items.forEach(function(it){
      var d=document.createElement('div'); d.className='res-item';
      d.innerHTML='<div class="k">'+it[0]+'</div><div class="v">'+it[1]+'</div>';
      grid.appendChild(d);
    });

    var tb = $('sel-res-table').querySelector('tbody'); tb.innerHTML='';
    var rows = [
      ['Base material / 基材', base||'—'],
      ['Surface treatment / 表面处理', surface||'—'],
      ['Target roughness / 粗糙度', rough? (rough+' μm') : '—'],
      ['Equipment / 设备', equip||'—'],
      ['Power / 功率', power||'—'],
      ['Service life / 年限', life||'—'],
      ['Recovery system / 回收', recover||'—'],
      ['Dust requirement / 环保', env||'—'],
      ['Main feature / 主料特性', main.feat],
      ['Sub material / 副料', sub ? (sub.cn+' / '+sub.en+' ('+subCode+')') : '— (Single media)'],
      ['Sub spec / 副料规格', sub ? specByShape(sub, rough) : '— (Single media)'],
      ['Sub feature / 副料特性', sub ? sub.feat : 'Single media, no sub needed'],
      ['Entry point / 选购切入点', ind.note]
    ];
    rows.forEach(function(r){ var tr=document.createElement('tr'); tr.innerHTML='<td>'+r[0]+'</td><td>'+r[1]+'</td>'; tb.appendChild(tr); });

    var factor = (recover === '有') ? 1 : 1.6;
    if(thr > 0){
      var lo = (thr * ind.consLow  / 1000 * factor).toFixed(1);
      var mid= (thr * (ind.consLow+ind.consHigh)/2 / 1000 * factor).toFixed(1);
      var hi = (thr * ind.consHigh / 1000 * factor).toFixed(1);
      var tr=document.createElement('tr');
      tr.innerHTML='<td>Annual use / 年耗量 (tons)</td><td><b>'+(recover==='有'?'with recovery':'no recovery ×1.6')+' → '+lo+' ~ '+hi+' t (mid '+mid+')</b></td>';
      tb.appendChild(tr);
    } else {
      var tr=document.createElement('tr');
      tr.innerHTML='<td>Annual use / 年耗量</td><td>No throughput entered → rate '+ind.consLow+'~'+ind.consHigh+' kg/t ('+(recover==='有'?'with recovery':'no recovery ×1.6')+')</td>';
      tb.appendChild(tr);
    }

    var warn = $('sel-res-warn'); warn.innerHTML=''; var ws=[];
    if(life==='>8年') ws.push('⚠ Old equipment: drop particle size one grade and check impeller/blade wear;');
    if(power==='低(<15kW)') ws.push('⚠ Low power: avoid large particle clogging, recommend ≤S280/G40;');
    if(env==='严格(<5mg/m³)') ws.push('🌿 Strict dust: prefer GL-grade + sealed system, dust <5mg/m³;');
    if(recover==='无') ws.push('🔧 No recovery: add magnetic + air separation to cut consumption 30%+;');
    if(ws.length){ warn.style.display='block'; ws.forEach(function(x){var s=document.createElement('span');s.className='w';s.textContent=x;warn.appendChild(s);}); }
    else warn.style.display='none';

    var rationale = 'Basis: '+base+' ｜ '+surface+' ｜ Rz '+rough+'μm ｜ '+equip+'；';
    rationale += (recover==='有') ? 'recovery installed → industry-standard mix/long-life media ('+code+')；' : 'no recovery → standard media + recommend adding recovery；';
    if(thr>0) rationale += 'throughput ~'+thr+' t.';
    $('sel-res-note').textContent = 'Rationale: ' + rationale + ( (thr>0 && (thr*(ind.consLow+ind.consHigh)/2/1000*factor)>=300) ? ' ｜ ≥300t → strategic client: on-site visit + custom blending.' : (thr>0 ? ' ｜ <300t → remote video diagnosis + data report.' : ''));

    var more='';
    if(base === '不锈钢' || base === '有色金属(铝/铜/锌)'){
      if(mainCode === 'O'){
        more='Price advantage: 304 cut wire (O) is cheaper and more angular than 304 stainless shot, suits cleaning/roughening; for spherical finish or shot peening use 304 stainless shot (J); for magnetic applications use 410 cut wire (P).';
      } else {
        more='Shot peening requires spherical stainless shot (J) to induce residual compressive stress; high-demand springs/gears can also use stainless cut wire (O) — longer life, more uniform size, retains angularity, avoids iron contamination; for magnetic applications use 410 cut wire (P).';
      }
    } else if(surface === '喷丸强化'){
      if(equip.indexOf('喷砂') >= 0){
        more='Pressure-blasting shot peening must use steel grit/bearing grit (C/D) only — never grinding shot or cut wire; if switching to wheel blasting, cast steel shot (A) or peening grinding shot G82B (H-grade) gives better fatigue life.';
      } else {
        more='Shot peening most widely uses cast steel shot (A) — spherical, tough, durable, the mainstream for gears/crankshafts/connecting rods; cut wire (E) lasts longer with uniform size, common for high-demand springs/gears; peening grinding shot G82B (H-grade) is the heaviest-duty peening choice (grinding shot G70 is a cleaning grade, not for peening); for stainless/non-ferrous parts use stainless shot (J) or cut wire (O/P) to avoid iron contamination.';
      }
    } else if(['F','N'].indexOf(mainCode)>=0) {
      more='More options: general grinding shot (N, roundness G3) is an economical alternative — lower cost, suits budget-sensitive scenarios.';
    } else if(base==='黑色金属(碳钢/铸铁)') {
      more='Economical alternatives: recycled cut wire (E) / general grinding shot (N, roundness G3); if stronger cutting is needed, the main media is already blended per industry.';
    } else {
      more='See the abrasive database for each material\'s spec column.';
    }
    $('sel-res-more').textContent = 'More options: ' + more;

    $('sel-result').style.display='block';
    $('sel-result').scrollIntoView({behavior:'smooth'});
  }
  $('sel-gen').addEventListener('click', gen);
  $('sel-reset').addEventListener('click', function(){
    $('sel-section') && document.querySelectorAll('.sel-section select, .sel-section input').forEach(function(e){ e.value=''; });
    $('sel-result').style.display='none';
  });

  /* ---- Render hidden reference tables ---- */
  (function renderTables(){
    var ta=$('sel-tbl-abr').querySelector('tbody');
    Object.keys(ABR).forEach(function(k){var a=ABR[k];var tr=document.createElement('tr');
      tr.innerHTML='<td>'+k+'</td><td>'+a.cn+' / '+a.en+'</td><td>'+a.mat+'</td><td>'+a.hard+'</td><td>'+a.shape+'</td><td>'+a.feat+'</td><td>'+a.cyc+'</td><td>'+a.spec+'</td>';
      ta.appendChild(tr);});
    var tm=$('sel-tbl-matrix').querySelector('tbody');
    Object.keys(MATRIX).forEach(function(k){var m=MATRIX[k];var tr=document.createElement('tr');
      tr.innerHTML='<td>'+IND[k].en+'</td><td>'+m.wheel[0]+'</td><td>'+m.wheel[1]+'</td><td>'+m.wheel[2]+'</td><td>'+m.blast[0]+'</td><td>'+m.blast[1]+'</td><td>'+m.blast[2]+'</td>';
      tm.appendChild(tr);});
    var ti=$('sel-tbl-ind').querySelector('tbody');
    Object.keys(IND).forEach(function(k){var i=IND[k];var tr=document.createElement('tr');
      tr.innerHTML='<td>'+i.en+' / '+i.zh+'</td><td>'+i.consLow+'</td><td>'+i.consHigh+'</td><td>'+i.main+'</td><td>'+i.sub+'</td><td>'+i.mix+'</td><td>'+i.note+'</td>';
      ti.appendChild(tr);});
  })();

  /* ============ COST COMPARISON A/B ============ */
  var CCY_SYM = {USD:'$',CNY:'¥',EUR:'€'};
  var CCY_NAME = {USD:'USD',CNY:'CNY',EUR:'EUR'};

  function fillAbrOptions(sel){
    ['A','B','C','D','E','F','G','H','I','J','K','L','M','N','O','P'].forEach(function(c){
      var a = ABR[c];
      var opt = document.createElement('option');
      opt.value = c;
      opt.textContent = c + ' ' + a.cn + ' / ' + a.en;
      sel.appendChild(opt);
    });
  }
  document.querySelectorAll('.sel-abr-type').forEach(fillAbrOptions);

  function costNum(sid, k){
    var el = document.querySelector('.sel-num[data-sid="'+sid+'"][data-k="'+k+'"]');
    var v = parseFloat(el.value);
    return (isFinite(v) && v > 0) ? v : 0;
  }
  function fmt(n){
    return n.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
  }
  function ccyStr(n, ccy){
    return CCY_SYM[ccy] + fmt(n);
  }
  function showV(id, txt, cls){
    var el = $(id);
    el.textContent = txt;
    el.className = 'v' + (cls ? ' '+cls : '');
  }

  $('sel-cost-gen').addEventListener('click', function(){
    var ccy = $('sel-ccy').value;
    var build = function(sid){
      var price = costNum(sid,'price'), consumed = costNum(sid,'consumed');
      var power = costNum(sid,'power'), labor = costNum(sid,'labor');
      var depm  = costNum(sid,'depm'),  dust  = costNum(sid,'dust');
      var scrap = costNum(sid,'scrap'), work  = costNum(sid,'work');
      var mat   = price * consumed;
      var total = mat + power + labor + depm + dust - scrap;
      return {price:price, consumed:consumed, power:power, labor:labor, depm:depm, dust:dust, scrap:scrap, work:work, mat:mat, total:total,
              cpt: work > 0 ? total / work : null};
    };
    var a = build('a'), b = build('b');

    var warns = [];
    if(a.price === 0 || a.consumed === 0) warns.push('Scenario A: unit price/consumed missing, fill ② and ③.');
    if(b.price === 0 || b.consumed === 0) warns.push('Scenario B: unit price/consumed missing, fill ② and ③.');
    if(a.work === 0) warns.push('Scenario A: no workpiece tons ⑨, cannot compute cost per ton.');
    if(b.work === 0) warns.push('Scenario B: no workpiece tons ⑨, cannot compute cost per ton.');

    var tbody = $('sel-cost-tbody'); tbody.innerHTML = '';
    var rows = [
      {k:'Material Cost = price × consumed', a:a.mat, b:b.mat, t:'money'},
      {k:'Power Cost', a:a.power, b:b.power, t:'money'},
      {k:'Labor Cost', a:a.labor, b:b.labor, t:'money'},
      {k:'Depreciation & Maintenance', a:a.depm, b:b.depm, t:'money'},
      {k:'Dust Control Cost', a:a.dust, b:b.dust, t:'money'},
      {k:'Scrap Recovery (−)', a:-a.scrap, b:-b.scrap, t:'money'},
      {k:'Total Cost', a:a.total, b:b.total, t:'money'},
      {k:'Workpiece Tons', a:a.work, b:b.work, t:'num'},
      {k:'Cost per Ton', a:a.cpt, b:b.cpt, t:'money'}
    ];
    rows.forEach(function(r){
      var tr = document.createElement('tr');
      var thd = document.createElement('td'); thd.textContent = r.k;
      var mk = function(v, cell){
        var s = '—';
        if(v !== null && v !== undefined && isFinite(v)){
          s = (r.t === 'num') ? fmt(v) : ccyStr(v, ccy);
        }
        cell.textContent = s;
        cell.style.fontWeight = (r.k.indexOf('Total') >= 0 || r.k.indexOf('Cost per Ton') >= 0) ? '700' : '400';
      };
      var td1 = document.createElement('td'), td2 = document.createElement('td');
      mk(r.a, td1); mk(r.b, td2);
      if(r.k.indexOf('Cost per Ton') >= 0 && a.cpt !== null && b.cpt !== null){
        if(a.cpt < b.cpt){ td1.innerHTML = '<b style="color:#176b34">' + td1.textContent + ' ✓ better</b>'; }
        else if(b.cpt < a.cpt){ td2.innerHTML = '<b style="color:#176b34">' + td2.textContent + ' ✓ better</b>'; }
      }
      tr.appendChild(thd); tr.appendChild(td1); tr.appendChild(td2);
      tbody.appendChild(tr);
    });

    showV('sel-cpt-a', a.cpt !== null ? ccyStr(a.cpt, ccy) + ' / ton' : '—',
          (a.cpt !== null && b.cpt !== null && a.cpt < b.cpt) ? 'win' : '');
    showV('sel-cpt-b', b.cpt !== null ? ccyStr(b.cpt, ccy) + ' / ton' : '—',
          (a.cpt !== null && b.cpt !== null && b.cpt < a.cpt) ? 'win' : '');
    showV('sel-cpt-diff', '—', '');
    showV('sel-cpt-total', '—', '');

    var verdict = $('sel-cost-verdict');
    if(warns.length){
      verdict.className = 'sel-verdict warn';
      verdict.style.display = 'block';
      verdict.innerHTML = '⚠ ' + warns.join('<br>⚠ ');
    } else {
      var saving = a.cpt - b.cpt;
      var msg = '';
      if(Math.abs(saving) < 0.005){
        msg = 'Both scenarios have essentially equal cost per ton (' + ccyStr(a.cpt, ccy) + ' / ton).';
        verdict.className = 'sel-verdict';
        showV('sel-cpt-diff', '≈ 0.00', '');
        showV('sel-cpt-total', '≈ 0.00', '');
      } else if(saving > 0){
        var totalSave = saving * a.work;
        msg = 'Scenario B is better ✓: cost per ton is lower by ' + ccyStr(saving, ccy) + ', at Scenario A workpiece ' + fmt(a.work) + ' t, this period saves ~' + ccyStr(totalSave, ccy) + '.';
        verdict.className = 'sel-verdict';
        showV('sel-cpt-diff', '-' + ccyStr(saving, ccy) + ' / ton (save)', 'win');
        showV('sel-cpt-total', ccyStr(totalSave, ccy), 'win');
      } else {
        var totalSave2 = (-saving) * a.work;
        msg = 'Scenario A is better ✓: cost per ton is lower by ' + ccyStr(-saving, ccy) + ', at Scenario A workpiece ' + fmt(a.work) + ' t, this period saves ~' + ccyStr(totalSave2, ccy) + '.';
        verdict.className = 'sel-verdict';
        showV('sel-cpt-diff', '+' + ccyStr(-saving, ccy) + ' / ton (extra)', 'lose');
        showV('sel-cpt-total', ccyStr(totalSave2, ccy), '');
      }
      verdict.style.display = 'block';
      verdict.textContent = msg;
    }
    $('sel-cost-summary').textContent = 'Basis: ' + CCY_NAME[ccy] + ' · same-period cost per ton comparison';
    $('sel-cost-result').style.display = 'block';
    $('sel-cost-result').scrollIntoView({behavior:'smooth'});
  });

  $('sel-cost-reset').addEventListener('click', function(){
    document.querySelectorAll('.sel-abr-type,.sel-num').forEach(function(e){ e.value = ''; });
    $('sel-cost-result').style.display = 'none';
  });

  /* ============ SELECTOR LEAD CAPTURE (PDF report) ============ */
  var selLeadForm = $('sel-lead-form');
  var selLcStatus = $('sel-lc-status');
  var selHasAlerted = false;
  selLeadForm.addEventListener('submit', function (e) {
    e.preventDefault();
    if (selHasAlerted) return;
    selHasAlerted = true;
    var email = ($('sel-lead-email').value || '').trim();
    if (!email) {
      selLcStatus.textContent = 'Please enter your work email.';
      selLcStatus.className = 'sel-lc-status err';
      selHasAlerted = false;
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      selLcStatus.textContent = 'That email does not look valid — please double-check.';
      selLcStatus.className = 'sel-lc-status err';
      selHasAlerted = false;
      return;
    }
    var subject = 'Selection report PDF request — ' + email;
    var body = 'Email: ' + email + '\n\nI generated an abrasive selection recommendation on your site and would like the full PDF report.\n\nMy selections:\n(Please paste your selector inputs here if you want a tailored report.)';
    var mailHref = 'mailto:china_k@fengerda.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    var waHref = 'https://wa.me/8618266010172?text=' + encodeURIComponent(subject + '\n\n' + body);
    var mailLink = document.createElement('a');
    mailLink.href = mailHref; mailLink.target = '_blank'; mailLink.rel = 'noopener';
    mailLink.textContent = 'open the pre-filled email';
    var waLink = document.createElement('a');
    waLink.href = waHref; waLink.target = '_blank'; waLink.rel = 'noopener';
    waLink.textContent = 'send via WhatsApp';
    selLcStatus.textContent = 'Your details are ready: ';
    selLcStatus.appendChild(mailLink);
    selLcStatus.appendChild(document.createTextNode(' or '));
    selLcStatus.appendChild(waLink);
    selLcStatus.appendChild(document.createTextNode('. Reply within 24 working hours.'));
    selLcStatus.className = 'sel-lc-status';
  });

  /* ============ LEAD FORM (main contact) ============ */
  var leadForm = $('lead-form');
  var statusEl = $('form-status');
  var hasAlerted = false;
  leadForm.addEventListener('submit', function (e) {
    e.preventDefault();
    if (hasAlerted) return;
    hasAlerted = true;

    var name = ($('lf-name').value || '').trim();
    var company = ($('lf-company').value || '').trim();
    var country = ($('lf-country').value || '').trim();
    var email = ($('lf-email').value || '').trim();
    var whatsapp = ($('lf-whatsapp').value || '').trim();
    var scene = ($('lf-scene').value || '').trim();

    if (!name || !email) {
      statusEl.textContent = 'Please enter at least your name and work email.';
      statusEl.className = 'form-status err';
      hasAlerted = false;
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      statusEl.textContent = 'The email address does not look valid - please double-check it.';
      statusEl.className = 'form-status err';
      hasAlerted = false;
      return;
    }

    var lines = [];
    lines.push('Name: ' + name);
    if (company) lines.push('Company: ' + company);
    if (country) lines.push('Country / Region: ' + country);
    lines.push('Email: ' + email);
    if (whatsapp) lines.push('WhatsApp: ' + whatsapp);
    if (scene) lines.push('');
    if (scene) lines.push('Application details:');
    if (scene) lines.push(scene);
    var body = lines.join('\n');

    var subject = 'Abrasive recommendation request - ' + name;
    var mailHref = 'mailto:china_k@fengerda.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    var waHref = 'https://wa.me/8618266010172?text=' + encodeURIComponent(subject + '\n\n' + body);

    var mailLink = document.createElement('a');
    mailLink.href = mailHref; mailLink.target = '_blank'; mailLink.rel = 'noopener';
    mailLink.textContent = 'open the pre-filled email draft';
    var waLink = document.createElement('a');
    waLink.href = waHref; waLink.target = '_blank'; waLink.rel = 'noopener';
    waLink.textContent = 'open a WhatsApp message';
    statusEl.textContent = 'Your details are ready: ';
    statusEl.appendChild(mailLink);
    statusEl.appendChild(document.createTextNode(' or '));
    statusEl.appendChild(waLink);
    statusEl.appendChild(document.createTextNode('. I reply within 24 working hours.'));
    statusEl.className = 'form-status';
  });
})();
</script>
